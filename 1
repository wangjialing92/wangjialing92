const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------------------------------------------------------------
   1) Hero 墨点画布
   颜色改为读取 CSS 变量 --forest-rgb / --ember-rgb （逗号分隔 rgb），
   主题切换时调用 refreshParticleColors 刷新一次即可。
---------------------------------------------------------------- */
const canvas = document.getElementById('particle-canvas');
const ctx = canvas.getContext('2d');
const mouse = { x: null, y: null };
let particles = [];
let W = 0, H = 0;
let FOREST_RGB = [0,48,33];
let EMBER_RGB  = [255,97,56];
function rgbaOf(rgb, a) { return `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${a})`; }
function refreshParticleColors() {
  const s = getComputedStyle(document.documentElement);
  const parse = (v) => v.trim().split(',').map(x => parseFloat(x.trim()));
  const a = parse(s.getPropertyValue('--forest-rgb'));
  const b = parse(s.getPropertyValue('--ember-rgb'));
  if (a.length === 3 && !isNaN(a[0])) FOREST_RGB = a;
  if (b.length === 3 && !isNaN(b[0])) EMBER_RGB  = b;
}
refreshParticleColors();
ThemeManager.onThemeChange(refreshParticleColors);

function resizeCanvas() {
  const hero = document.getElementById('hero');
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = hero.clientWidth; H = hero.clientHeight;
  canvas.width = W * dpr; canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  initParticles();
}
function initParticles() {
  const count = Math.min(Math.floor(W * H / 16000), 90);
  particles = Array.from({ length: count }, () => ({
    x: Math.random() * W, y: Math.random() * H,
    vx: (Math.random() - .5) * .3, vy: (Math.random() - .5) * .3,
    r: Math.random() * 1.8 + .8,
  }));
}
function drawParticles() {
  ctx.clearRect(0, 0, W, H);
  const LINK_DIST = 130, MOUSE_DIST = 180;
  for (const p of particles) {
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
    if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fillStyle = rgbaOf(FOREST_RGB, .4);
    ctx.fill();
  }
  for (let i = 0; i < particles.length; i++) {
    for (let j = i + 1; j < particles.length; j++) {
      const a = particles[i], b = particles[j];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (d < LINK_DIST) {
        ctx.strokeStyle = rgbaOf(FOREST_RGB, (1 - d / LINK_DIST) * .14);
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }
    if (mouse.x !== null) {
      const p = particles[i];
      const d = Math.hypot(p.x - mouse.x, p.y - mouse.y);
      if (d < MOUSE_DIST) {
        ctx.strokeStyle = rgbaOf(EMBER_RGB, (1 - d / MOUSE_DIST) * .55);
        ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
      }
    }
  }
  if (!reducedMotion) requestAnimationFrame(drawParticles);
}

/* ---------------------------------------------------------------
   2) 鼠标多层视差
---------------------------------------------------------------- */
const blobs = document.querySelectorAll('.blob');
window.addEventListener('mousemove', e => {
  const nx = e.clientX / window.innerWidth - .5;
  const ny = e.clientY / window.innerHeight - .5;
  if (!reducedMotion) {
    blobs.forEach(b => {
      const depth = parseFloat(b.dataset.depth);
      b.style.transform = `translate(${nx * depth * 1000}px, ${ny * depth * 1000}px)`;
    });
  }
  const rect = canvas.getBoundingClientRect();
  mouse.x = e.clientX - rect.left;
  mouse.y = e.clientY - rect.top;
}, { passive: true });
window.addEventListener('mouseleave', () => { mouse.x = mouse.y = null; });

/* ---------------------------------------------------------------
   3) Hero 滚动视差 + 导航栏 + 返回顶部（合并节流）
---------------------------------------------------------------- */
const navbar = document.getElementById('navbar');
const backTop = document.getElementById('back-top');
const heroInner = document.getElementById('hero-inner');
let ticking = false;
window.addEventListener('scroll', () => {
  if (ticking) return;
  ticking = true;
  requestAnimationFrame(() => {
    const y = window.scrollY;
    if (!reducedMotion && y < window.innerHeight) {
      heroInner.style.setProperty('--plax', `${y * .32}px`);
      heroInner.style.setProperty('--plax-fade', Math.min(y / window.innerHeight, .9));
    }
    navbar.classList.toggle('scrolled', y > 40);
    backTop.classList.toggle('show', y > 600);
    ticking = false;
  });
}, { passive: true });

/* ---------------------------------------------------------------
   4) 滚动进场
---------------------------------------------------------------- */
if ('IntersectionObserver' in window) {
  const revealObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: .15 });
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
} else {
  document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
}

/* ---------------------------------------------------------------
   5) 数字计数器（IntersectionObserver 兼容降级）
---------------------------------------------------------------- */
function runCounters() {
  document.querySelectorAll('.counter').forEach(el => {
    const target = +el.dataset.target;
    const start = performance.now(), dur = 1400;
    (function tick(now) {
      const t = Math.min((now - start) / dur, 1);
      el.textContent = Math.round(target * (1 - Math.pow(2, -10 * t)));
      if (t < 1) requestAnimationFrame(tick);
    })(start);
  });
}
if ('IntersectionObserver' in window) {
  const counterObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      counterObserver.unobserve(el);
      const target = +el.dataset.target;
      const start = performance.now(), dur = 1400;
      (function tick(now) {
        const t = Math.min((now - start) / dur, 1);
        el.textContent = Math.round(target * (1 - Math.pow(2, -10 * t)));
        if (t < 1) requestAnimationFrame(tick);
      })(start);
    });
  }, { threshold: .6 });
  document.querySelectorAll('.counter').forEach(el => counterObserver.observe(el));
} else { runCounters(); }

/* ---------------------------------------------------------------
   6) 技能条
---------------------------------------------------------------- */
if ('IntersectionObserver' in window) {
  const skillObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bar = entry.target.querySelector('i');
        bar.style.width = bar.dataset.value + '%';
        skillObserver.unobserve(entry.target);
      }
    });
  }, { threshold: .5 });
  document.querySelectorAll('.skill-bar').forEach(el => skillObserver.observe(el));
} else {
  document.querySelectorAll('.skill-bar i').forEach(b => { b.style.width = b.dataset.value + '%'; });
}

/* ---------------------------------------------------------------
   7) 荣誉手风琴：同一时刻只展开一个面板
---------------------------------------------------------------- */
document.querySelectorAll('.acc-item').forEach(item => {
  const head = item.querySelector('.acc-head');
  const body = item.querySelector('.acc-body');
  head.addEventListener('click', () => {
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.acc-item.open').forEach(o => {
      o.classList.remove('open');
      const b = o.querySelector('.acc-body'); if (b) b.style.maxHeight = '0px';
    });
    if (!isOpen) {
      item.classList.add('open');
      body.style.maxHeight = body.scrollHeight + 'px';
    }
  });
});

/* ---------------------------------------------------------------
   8) 图片灯箱
---------------------------------------------------------------- */
const lightbox = document.getElementById('lightbox');
const lightboxImg = document.getElementById('lightbox-img');
document.querySelectorAll('.gallery-img').forEach(img => {
  img.addEventListener('click', () => {
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  });
});
function closeLightbox() {
  lightbox.classList.add('hidden');
  lightbox.classList.remove('flex');
  document.body.style.overflow = '';
}
lightbox.addEventListener('click', closeLightbox);
window.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

/* ---------------------------------------------------------------
   9) 移动端菜单 / 返回顶部 / 年份
---------------------------------------------------------------- */
const menuBtn = document.getElementById('menu-btn');
const mobileMenu = document.getElementById('mobile-menu');
menuBtn.addEventListener('click', () => {
  const open = mobileMenu.classList.toggle('open');
  menuBtn.innerHTML = open ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
});
mobileMenu.querySelectorAll('a').forEach(a =>
  a.addEventListener('click', () => {
    mobileMenu.classList.remove('open');
    menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';
  })
);
backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
document.getElementById('year').textContent = new Date().getFullYear();

/* ---------------------------------------------------------------
   10) Slogan 打字机循环
---------------------------------------------------------------- */
const slogans = [
  '让 AI 有温度，让文字有力量。',
  '用人文之心，驭智能之力。',
  '好奇心是最强的自驱力。',
];
if (!reducedMotion) {
  const typed = document.getElementById('typed-slogan');
  let sIdx = 0, cIdx = slogans[0].length, deleting = false;
  (function typeLoop() {
    const s = slogans[sIdx];
    cIdx += deleting ? -1 : 1;
    typed.textContent = s.slice(0, cIdx);
    let wait = deleting ? 30 : 110;
    if (!deleting && cIdx === s.length) { wait = 2400; deleting = true; }
    else if (deleting && cIdx === 0) { deleting = false; sIdx = (sIdx + 1) % slogans.length; wait = 600; }
    setTimeout(typeLoop, wait);
  })();
}

/* 启动画布 */
resizeCanvas();
window.addEventListener('resize', resizeCanvas);
if (reducedMotion) drawParticles();
else requestAnimationFrame(drawParticles);

})();


/* ============================================================
   统一启动入口：
   —— readyState === 'loading' 时才监听 DOMContentLoaded，
      否则脚本执行时 DOM 已经就绪 → 直接执行 init()。
      解决浏览器自动化/快缓存场景下 ThemeManager.init() 永不执行的竞态。
============================================================ */
(function boot() {
  function start() {
    ThemeManager.init();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
