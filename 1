<script>
/* ================================================================
   【主题管理模块】
   - localStorage 持久化 + 首次跟随系统（未手动选择时）
   - 点击按钮 / Ctrl+Cmd+T 快捷键切换
   - 圆形扩散遮罩过渡（从按钮位置扩散到整屏）
   - 620ms 动画锁防抖
   - ARIA：aria-pressed / aria-label / aria-live 实时播报
   对外 API: { init(), toggle(), onThemeChange(fn) }
================================================================ */
const ThemeManager = (function () {
  'use strict';
  const LIGHT_BG = '#f3f0e7';      // 浅色主题背景色
  const DARK_BG  = '#0b1613';      // 深色主题背景色（深夜森林）
  const STORAGE_KEY = 'theme';
  const OVERLAY_DURATION = 600;    // 遮罩扩散动画 ms
  const SWITCH_AT      = 280;      // 遮罩扩散到"过半"这一刻，切 DOM 颜色
  const LOCK_MS        = OVERLAY_DURATION + 20;

  let _isAnimating = false;
  let _isUserStored = null;        // null=跟随系统；'dark'|'light'=用户手动选择
  let _btn, _btnIcon, _overlay, _liveRegion;
  let _themeChangeCbs = [];

  function _getStored() { try { return localStorage.getItem(STORAGE_KEY); } catch(e){ return null; } }
  function _setStored(v) { try { if (v === null) localStorage.removeItem(STORAGE_KEY); else localStorage.setItem(STORAGE_KEY, v); } catch(e){} }
  function _prefersDarkSys() { return !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches); }
  function _isDarkNow() { return document.documentElement.classList.contains('dark'); }

  /* 发布主题切换事件：粒子画布、技能条渐变等 JS 层需要手动刷新颜色的模块 */
  function _fireThemeChange(dark) {
    _themeChangeCbs.forEach(fn => { try { fn(dark); } catch(e){} });
  }

  function _applyTheme(dark) {
    const html = document.documentElement;
    if (dark) html.classList.add('dark');
    else html.classList.remove('dark');
    html.classList.remove('dark-pending');   // 移除 FOUC 临时类
    _fireThemeChange(dark);
  }

  function _updateBtn(dark) {
    if (!_btn) return;
    _btn.setAttribute('aria-pressed', String(dark));
    _btn.setAttribute('aria-label', `切换明暗主题，当前为${dark ? '深色' : '浅色'}`);
    if (_btnIcon) _btnIcon.textContent = dark ? '☀️' : '🌙';
  }

  function _updateLive(dark) {
    if (_liveRegion) _liveRegion.textContent = `已切换为${dark ? '深' : '浅'}色主题`;
  }

  /* 圆形扩散遮罩：如果 sourceEvent 有 clickX/Y，就从点击位置扩散；否则从按钮中心 */
  function _startOverlay(dark, ev) {
    if (!_overlay) return;
    let cx, cy;
    if (ev && typeof ev.clientX === 'number') { cx = ev.clientX; cy = ev.clientY; }
    else if (_btn) { const r = _btn.getBoundingClientRect(); cx = r.left + r.width/2; cy = r.top + r.height/2; }
    else { cx = window.innerWidth/2; cy = window.innerHeight/2; }

    _overlay.classList.remove('play');
    _overlay.style.transition = 'none';
    _overlay.style.left = cx + 'px';
    _overlay.style.top  = cy + 'px';
    _overlay.style.backgroundColor = dark ? DARK_BG : LIGHT_BG;
    _overlay.style.transform = 'translate(-50%,-50%) scale(0)';
    _overlay.style.opacity = '.96';
    // 强制 reflow 后触发扩散
    /* eslint-disable no-unused-expressions */
    _overlay.offsetWidth;
    _overlay.classList.add('play');
  }
  function _stopOverlay() {
    if (!_overlay) return;
    _overlay.style.opacity = '0';
    setTimeout(() => _overlay && _overlay.classList.remove('play'), 260);
  }

  /* —— 对外：手动触发切换（按钮点击 / 快捷键 / JS 调用）—— */
  function toggle(sourceEvent) {
    if (_isAnimating) return;
    _isAnimating = true;
    const willBeDark = !_isDarkNow();
    _isUserStored = willBeDark ? 'dark' : 'light';
    _setStored(_isUserStored);

    // 按钮微交互：图标 360° 旋转（带回弹）
    if (_btn) {
      _btn.classList.add('spin');
      setTimeout(() => _btn && _btn.classList.remove('spin'), 700);
    }

    _startOverlay(willBeDark, sourceEvent);

    // 遮罩过半 → 实际切换 DOM + UI + 播报
    setTimeout(() => {
      _applyTheme(willBeDark);
      _updateBtn(willBeDark);
      _updateLive(willBeDark);
    }, SWITCH_AT);

    // 动画结束 → 释放锁 + 遮罩淡出
    setTimeout(() => {
      _stopOverlay();
      _isAnimating = false;
    }, LOCK_MS);
  }

  function _bindHotkeys() {
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 't' || e.key === 'T')) {
        e.preventDefault();   // 拦截浏览器 Ctrl+T → 新标签
        toggle(null);
      }
    });
  }

  function _bindSystemFollow() {
    const mql = matchMedia('(prefers-color-scheme: dark)');
    const onChange = (ev) => {
      // 用户一旦手动点击过（_isUserStored 非空）→ 不再跟随系统
      if (_isUserStored !== null) return;
      const shouldDark = ev.matches;
      _applyTheme(shouldDark);
      _updateBtn(shouldDark);
    };
    if (mql.addEventListener) mql.addEventListener('change', onChange);
    else if (mql.addListener)    mql.addListener(onChange);     // Safari 13 兼容
  }

  function onThemeChange(fn) { if (typeof fn === 'function') _themeChangeCbs.push(fn); }

  function init() {
    _btn = document.getElementById('themeBtn');
    _btnIcon = _btn && _btn.querySelector('.icon');
    _overlay = document.getElementById('themeOverlay');
    _liveRegion = document.getElementById('themeLiveRegion');

    const stored = _getStored();
    _isUserStored = stored;        // null 或 'dark'|'light'
    const shouldDark = (stored !== null) ? (stored === 'dark') : _prefersDarkSys();

    _applyTheme(shouldDark);
    _updateBtn(shouldDark);

    if (_btn) _btn.addEventListener('click', (e) => toggle(e));
    _bindHotkeys();
    _bindSystemFollow();

    // —— 移除 FOUC 用的 no-transitions 类（页面所有样式加载后）
    function dropNoTransitions() {
      document.documentElement.classList.remove('no-transitions');
    }
    if (document.readyState === 'complete') dropNoTransitions();
    else window.addEventListener('load', dropNoTransitions);
  }

  return { init, toggle, onThemeChange };
})();


